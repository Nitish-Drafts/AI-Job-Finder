# ========================================================
# SYSTEM CONFIGURATION VARIABLES
# ========================================================

# Base application parameters
PROJECT_NAME="AI Job Finder"

# JWT token security parameters
SECRET_KEY="supersecretjwtkeythatshouldbechangedinproduction123!"
APP_ENV="development"
FRONTEND_URL="http://localhost:5173"
ENABLE_SCHEDULER=true

# Local Database connections (Docker services mapping)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_job_finder"
DATABASE_SYNC_URL="postgresql://postgres:postgres@localhost:5432/ai_job_finder"

# OpenAI API Key (Required for GPT parsing/matching; falls back to local TF-IDF if blank)
OPENAI_API_KEY=""
RESEND_API_KEY=""

# Custom SMTP Mail server parameters for matching job alerts
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@aijobfinder.com"

# Social Authentication parameters (Google, GitHub, LinkedIn)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
